# Copy to .env, then fill in account and user from Snowflake. .env is Git-ignored.
# For browser-based SSO, keep EXTERNALBROWSER and leave PASSWORD empty.
# If your account uses password login instead, set AUTHENTICATOR=snowflake and PASSWORD.
CARECOST_DB=data/processed/boston.sqlite
CARECOST_EMBEDDING_MODEL=data/models/bge-small-en-v1.5
CARECOST_OLLAMA_MODEL=mistral:7b-instruct
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=CARECOST_WH
SNOWFLAKE_DATABASE=CARECOST
SNOWFLAKE_SCHEMA=RAW
CARECOST_MART_SCHEMA=ANALYTICS
